# ── Deployment ──────────────────────────────────────────────────────────────
# LITE (Streamlit Community Cloud) | FULL (container/laptop)
DEPLOYMENT_PROFILE=LITE

# ── LLM ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional failover provider (Groq, or any OpenAI-compatible endpoint)
GROQ_API_KEY=

# Ordered, comma-separated model chains (first = highest preference)
# Using Groq as primary (reliable), Gemini as vision-only failover
TIER_FAST_CHAIN=local:qwen2.5-7b-instruct,openai/gpt-oss-20b,qwen/qwen3.8-27b,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.8-flash
TIER_REASONING_CHAIN=openai/gpt-oss-120b,local:qwen2.5-7b-instruct,gemini-3.6-flash,qwen/qwen3.8-27b,gemini-3.8-flash
TIER_VISION_CHAIN=gemini-3.6-flash,gemini-3.5-flash,gemini-3.8-flash

# Hard cap: reasoning tier calls per run (architecture invariant DEC-1)
MAX_REASONING_CALLS_PER_RUN=4

# ── Search ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
# jina | serper
SEARCH_SECONDARY_PROVIDER=jina
SERPER_API_KEY=
JINA_API_KEY=

# ── Fetch ────────────────────────────────────────────────────────────────────
# free key → 500 RPM; empty → 20 RPM (shared IP)
JINA_READER_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────────
# public-read scope only; avoids shared-IP 60 req/hr
GITHUB_TOKEN=

# ── Demo Safety ──────────────────────────────────────────────────────────────
# shared judge passcode; empty = open access (dev only)
DEMO_ACCESS_CODE=
# 30% of daily quota reserved for judge pool
JUDGE_RESERVE_RATIO=0.30
# admission control ceiling
MAX_CONCURRENT_RUNS=3

# ── Privacy & Retention ───────────────────────────────────────────────────────
# 15 min; purge run state + vault after completion
PII_VAULT_TTL_SECONDS=900

# ── Phase Timing (speed vs quality tradeoff) ───────────────────────────────────
# Lower values = faster execution, potentially fewer opportunities
# Higher values = more thorough search, slower execution
# Stop new fetches after this time (seconds)
PHASE_A_SOFT_DEADLINE_S=60
# Hard stop for Phase A (seconds)
PHASE_A_HARD_DEADLINE_S=75
# Phase B (SOP generation) deadline (seconds)
PHASE_B_DEADLINE_S=45

# ── API Configuration ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Auto-reload in development
API_RELOAD=false

# ── OCR Configuration ───────────────────────────────────────────────────────
# OCR uses Gemini Vision API to extract text from scanned PDFs
# Images are sent to the API for processing - review privacy policy
# Enable OCR fallback for scanned PDFs
ENABLE_OCR=true
# Chars below which OCR triggers
OCR_THRESHOLD_CHARS=50
# Max pages to OCR per PDF (cost control)
OCR_MAX_PAGES=20

# ── Document Processing ───────────────────────────────────────────────────────
# pymupdf (AGPL, fast) | pypdf (BSD, permissive)
PDF_BACKEND=pymupdf

LOCAL_LLM_ENABLED=true
LOCAL_LLM_BASE_URL=http://127.0.0.1:8088/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct
LOCAL_LLM_PARALLEL=3
LOCAL_LLM_CTX=18432
LOCAL_LLM_MAX_INPUT_TOKENS=4500
LOCAL_LLM_AUTOSTART=true
LOCAL_LLM_SERVER_PATH=C:\llama-cpp-cuda\llama-server.exe
LOCAL_LLM_MODEL_PATH=C:\Project_RAG\models\Qwen2.5-7B-Instruct-Q4_K_M.gguf
LOCAL_LLM_EXTRA_ARGS=-fa on
RUN_HARD_DEADLINE_S=360
RUN_SOFT_DEADLINE_S=240
RUN_RESERVE_AFTER_AUDIT_S=90

KB_ENABLED=true
KB_PATH=runs/knowledge.db
KB_OPP_TTL_DAYS=7
KB_SEARCH_TTL_HOURS=24

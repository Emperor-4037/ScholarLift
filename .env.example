# ── Deployment ──────────────────────────────────────────────────────────────
DEPLOYMENT_PROFILE=LITE          # LITE (Streamlit Community Cloud) | FULL (container/laptop)

# ── LLM ─────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional failover provider (Groq, or any OpenAI-compatible endpoint)
GROQ_API_KEY=

# Ordered, comma-separated model chains (first = highest preference)
TIER_FAST_CHAIN=gemini-3.5-flash-lite,gemini-3.6-flash
TIER_REASONING_CHAIN=gemini-1.5-pro,gemini-3.6-flash
TIER_VISION_CHAIN=gemini-3.5-flash

# Hard cap: reasoning tier calls per run (architecture invariant DEC-1)
MAX_REASONING_CALLS_PER_RUN=4

# ── Search ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
SEARCH_SECONDARY_PROVIDER=jina   # jina | serper
SERPER_API_KEY=
JINA_API_KEY=

# ── Fetch ────────────────────────────────────────────────────────────────────
JINA_READER_KEY=                 # free key → 500 RPM; empty → 20 RPM (shared IP)

# ── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=                    # public-read scope only; avoids shared-IP 60 req/hr

# ── Demo Safety ──────────────────────────────────────────────────────────────
DEMO_ACCESS_CODE=                # shared judge passcode; empty = open access (dev only)
JUDGE_RESERVE_RATIO=0.30         # 30% of daily quota reserved for judge pool
MAX_CONCURRENT_RUNS=3            # admission control ceiling

# ── Privacy & Retention ───────────────────────────────────────────────────────
PII_VAULT_TTL_SECONDS=900        # 15 min; purge run state + vault after completion

# ── Phase Timing (speed vs quality tradeoff) ───────────────────────────────────
# Lower values = faster execution, potentially fewer opportunities
# Higher values = more thorough search, slower execution
PHASE_A_SOFT_DEADLINE_S=60       # Stop new fetches after this time (seconds)
PHASE_A_HARD_DEADLINE_S=75       # Hard stop for Phase A (seconds)
PHASE_B_DEADLINE_S=45            # Phase B (SOP generation) deadline (seconds)

# ── API Configuration ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false                # Auto-reload in development

# ── OCR Configuration ───────────────────────────────────────────────────────
# OCR uses Gemini Vision API to extract text from scanned PDFs
# Images are sent to the API for processing - review privacy policy
ENABLE_OCR=true                  # Enable OCR fallback for scanned PDFs
OCR_THRESHOLD_CHARS=50            # Chars below which OCR triggers
OCR_MAX_PAGES=20                 # Max pages to OCR per PDF (cost control)

# ── Document Processing ───────────────────────────────────────────────────────
PDF_BACKEND=pymupdf              # pymupdf (AGPL, fast) | pypdf (BSD, permissive)
